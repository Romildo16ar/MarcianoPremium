<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#0D0D1A"
    android:padding="24dp"
    android:gravity="center">

    <!-- Ícone do robô -->
    <TextView
        android:layout_width="100dp"
        android:layout_height="100dp"
        android:gravity="center"
        android:text="🤖"
        android:textSize="56sp"
        android:background="@drawable/bg_avatar"
        android:layout_marginBottom="24dp" />

    <!-- Mensagem enviada -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Você disse:"
        android:textColor="#555577"
        android:textSize="13sp"
        android:layout_marginBottom="4dp" />

    <TextView
        android:id="@+id/tvMensagem"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text=""
        android:textColor="#8888CC"
        android:textSize="15sp"
        android:gravity="center"
        android:fontFamily="monospace"
        android:background="@drawable/bg_card_dark"
        android:padding="12dp"
        android:layout_marginBottom="32dp" />

    <!-- Balão de resposta -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Marciano responde:"
        android:textColor="#00E5FF"
        android:textSize="13sp"
        android:textStyle="bold"
        android:layout_marginBottom="8dp" />

    <TextView
        android:id="@+id/tvResposta"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text=""
        android:textColor="#FFFFFF"
        android:textSize="22sp"
        android:textStyle="bold"
        android:gravity="center"
        android:background="@drawable/bg_card_resposta"
        android:padding="24dp"
        android:layout_marginBottom="48dp" />

    <!-- Botão voltar -->
    <Button
        android:id="@+id/btnVoltar"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:text="← NOVA MENSAGEM"
        android:textColor="#0D0D1A"
        android:textStyle="bold"
        android:background="@drawable/bg_btn_primary" />

</LinearLayout>
